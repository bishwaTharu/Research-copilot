# FreeLLMAPI / OpenAI-compatible Gateway configuration
GATEWAY_BASE_URL=http://localhost:31415/v1
GATEWAY_API_KEY=FreeLLMAPI-Key

# Model Mode: auto (FreeLLMAPI smart routing) or pinned (fixed models)
MODEL_MODE=auto
PINNED_DEFAULT_MODEL=gpt-4o-mini
PINNED_VERIFIER_MODEL=gpt-4o-mini
PINNED_VISION_MODEL=gpt-4o-mini

# Embeddings (ADR-4): "local" (deterministic offline hashing) or "gateway" (remote API)
EMBEDDING_BACKEND=local
EMBEDDING_API_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_FALLBACK_TO_LOCAL=true

# Data & Storage
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/copilot.db

# Privacy Default: allow_remote or local_only
PRIVACY_DEFAULT=allow_remote

# External Services
GROBID_URL=http://localhost:8070
CROSSREF_MAILTO=research-copilot@example.edu
OPENALEX_MAILTO=research-copilot@example.edu

# Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=100
